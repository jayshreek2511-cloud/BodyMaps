# Backend environment — copy to flask-server/.env and fill in.
# (.env is gitignored; never commit real values.)

# --- Web app ---
BASE_PATH=/
USE_SSL=false

# --- PanTS dataset (primary) ---
# Folder that contains metadata.xlsx + image_only/ + mask_only/.
# OPTIONAL for local dev: leave it unset (or pointing at a folder that does not
# exist) and the backend still boots — the case library/search will be empty,
# but the AI assistant still answers organ-volume questions because the mask/CT
# are pulled from the HuggingFace mirror (BodyMaps/iPanTSMini) on demand.
# Set it to your real dataset folder to enable the full case library.
# PANTS_PATH=C:/path/to/PanTS

# --- nnInteractive remote segmentation (disabled by default) ---
# Flask is the only client; keep the server private and never expose its key to
# the browser. See deploy/nninteractive.md before enabling outside local tests.
NNINTERACTIVE_ENABLED=false
NNINTERACTIVE_SERVER_URL=http://127.0.0.1:1527
# NNINTERACTIVE_API_KEY=
NNINTERACTIVE_MAX_SESSIONS_PER_USER=2
NNINTERACTIVE_DAILY_QUOTA=5
NNINTERACTIVE_IDLE_SECONDS=900
# CPU-only local fake session; only honored when NNINTERACTIVE_ENABLED=true.
NNINTERACTIVE_MOCK=false
# Writable dir for precomputed PanTS low-res volumes (make_lowres.py output).
# PANTS_LOWRES_PATH=/home/visitor/pants_lowres
# Enable only after the matching internal locations in deploy/nginx-bodymaps.conf
# have been installed and checked with `nginx -t`. Nginx then streams immutable
# dataset files itself instead of keeping Gunicorn threads busy for large CTs.
# BODYMAPS_ACCEL_REDIRECT_ENABLED=true

# --- Quiz catalog ---
# Use these only for local implementation testing before content review.
# BODYMAPS_QUIZ_CATALOG_PATH=/path/to/quiz_catalog.dev.json
# BODYMAPS_QUIZ_ALLOW_UNREVIEWED=1

# --- CancerVerse dataset (second, CT-only for now) ---
# Folder that contains image_only/CV_########/ct.nii.gz cases. The metadata CSV lives
# NEXT TO this folder: <parent>/CancerVerse_dataset_metadata.csv.
# Leave unset to disable CancerVerse (search/endpoints stay PanTS-only).
CANCERVERSE_PATH=/mnt/bodymaps/zzhou82/data/CancerVerse
# Writable dir for CancerVerse low-res volumes:
#   <CANCERVERSE_LOWRES_PATH>/image_only/CV_########/ct_lowres.nii.gz
CANCERVERSE_LOWRES_PATH=/home/visitor/cancerverse_lowres

# --- Database / sessions (fill in as needed) ---
# DB_USER=
# DB_PASS=
# DB_HOST=
# DB_NAME=
# SESSIONS_DIR_PATH=sessions
# PERMISSIONS_DIR=/home/visitor/data
# In-process inference admission control. The slot count includes the job
# running on the GPU plus jobs waiting behind it; excess requests receive 429
# and the frontend can retry after the response's Retry-After value.
# INFERENCE_MAX_PENDING=4
# Durable pull-worker queue cap (queued + leased + running jobs).
# INFERENCE_QUEUE_MAX_PENDING=8
# Keep BLAS/OpenMP from multiplying CPU threads inside each model subprocess.
# Set model-specific values only after measuring the host; these are safe
# process-wide defaults for a shared web server.
# OMP_NUM_THREADS=1
# MKL_NUM_THREADS=1
# OPENBLAS_NUM_THREADS=1
# NUMEXPR_NUM_THREADS=1
# EPAI_N_PROC_DA=2
# SHAPEKIT_CPU_NUM=2
# Comma-separated reverse-proxy networks allowed to supply X-Real-IP/X-Forwarded-For.
# Keep loopback default when nginx runs on this host. Never add public client ranges.
# BODYMAPS_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
# Exact comma-separated browser origins accepted by the Live Rooms websocket.
# Wildcards and path components are rejected.
# LIVE_ROOMS_ALLOWED_ORIGINS=https://bodymaps.wse.jhu.edu

# --- BodyMaps AI assistant (local Ollama) ---
# See src/components/AIAssistant/README_AI_MODEL_SETUP.md for full setup.
OLLAMA_BASE_URL=http://127.0.0.1:11434
# llama3.1 is the safe default: it never shows a chain-of-thought. qwen3:4b is
# faster but only stays clean if your Ollama honors "/no_think" (recent Ollama);
# on older Ollama, qwen3 leaks its reasoning, so prefer llama3.1 there.
BODYMAPS_OLLAMA_MODEL=llama3.1:latest
# Used automatically when a message includes images (screenshots / uploads).
BODYMAPS_OLLAMA_VISION_MODEL=qwen3-vl:4b
OLLAMA_LIST_TIMEOUT_SECONDS=5
OLLAMA_CHAT_TIMEOUT_SECONDS=180
# Only the CONNECT step is time-limited for streaming; the answer itself streams
# with no read timeout, so a slow but working reply is never cut off.
OLLAMA_CONNECT_TIMEOUT_SECONDS=20
OLLAMA_KEEP_ALIVE=30m
# Context window. NUM_PREDICT=-1 means "no token cap" — the model always
# finishes its answer instead of being cut off mid-sentence. Brevity for simple
# questions comes from the prompt, not from a cap.
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=-1
# Keep this false. With qwen3 it also sends "/no_think" so the model answers
# directly instead of generating a long (slow) reasoning chain first.
OLLAMA_THINK=false

# --- AI on-demand data cache ---
# Writable cache for the case mask/CT the AI downloads from HuggingFace when the
# local dataset is absent (used to answer organ-volume questions). Temp dir by default.
# AI_DATA_CACHE_PATH=/home/visitor/bodymaps_ai_cache

# --- Offline search/shuffle quality index ---
# Generated by scripts/compute_case_quality.py. Backend loads it once at startup.
# Leave unset to use metadata-only voxel/spacing ranking.
BODYMAPS_CASE_QUALITY_MANIFEST=/home/visitor/data/bodymaps_case_quality.v1.json
# Local Ollama vision model used only by the offline generator.
BODYMAPS_THUMBNAIL_VISION_MODEL=qwen3-vl:4b
BODYMAPS_THUMBNAIL_VISION_TIMEOUT_SECONDS=120

# --- Outbound email (password reset links) ---
# Without SMTP_USER/SMTP_PASSWORD the reset flow still works end-to-end: the
# message, link and all, is printed to the server log instead of being sent.
# GMAIL: SMTP_PASSWORD must be a 16-character App Password, NOT the account
# password — Google no longer accepts account passwords for SMTP. Generate one
# at Google Account > Security > 2-Step Verification > App passwords.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USER=
SMTP_PASSWORD=
# Defaults to SMTP_USER. Set it if the From address differs from the login.
SMTP_FROM=

# The site's own public address, used to build the reset link in the email (and
# the OAuth redirect_uri). Must match the scheme and host users actually visit.
# PUBLIC_BASE_URL=https://bodymaps.wse.jhu.edu

# --- Sponsored admin access (optional) ---
# The server-side coupon unlocks the unlimited Enterprise plan for a signed-in
# account. It does not grant the sensitive admin role or the admin API. Store
# only a SHA-256 digest here; generate it without putting the plaintext in a
# file or shell history, for example:
#   python -c "import hashlib,getpass; print(hashlib.sha256(getpass.getpass().encode()).hexdigest())"
# BODYMAPS_ADMIN_COUPON_SHA256=

# --- Proxies ---
# Set TRUST_PROXY=true when something you control sits in front of the app, and
# TRUST_PROXY_HOPS to how many such proxies there are. Getting the count wrong
# is not cosmetic: too low reads a proxy's address instead of the visitor's (so
# the analytics map stays empty), too high reads a client-supplied header (so
# visitors can forge their location). Defaults to 1.
# TRUST_PROXY=true
# TRUST_PROXY_HOPS=2
